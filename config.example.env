DAWNMESH_LISTEN=:8080
DAWNMESH_DATABASE=/data/dawnmesh.db
# Optional: pin a published GHCR image instead of using latest.
# DAWNMESH_IMAGE=ghcr.io/timelordfang/dawnmeshserver:1.0.0
DAWNMESH_INSTANCE_ID=replace-with-a-random-instance-id
DAWNMESH_INSTANCE_NAME=My DawnMesh Server
DAWNMESH_PUBLIC_URL=https://talk.example.com
DAWNMESH_ACCESS_TOKEN=replace-with-a-random-client-access-token
# Separate administrator credential for /admin/. Leave empty to disable admin APIs.
DAWNMESH_ADMIN_TOKEN=replace-with-a-random-admin-token
DAWNMESH_MAX_PARTICIPANTS=100
DAWNMESH_MAX_ROOMS=1000

# Internal control URL used by dawnmesh-server and public WSS URL used by phones.
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=wss://rtc.example.com
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
